{
  "name": "@byline/newsroom-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Byline's newsroom design system: shadcn base-nova on Tailwind 4, scoped to .byline-ui-root. Shared by the WordPress admin screens and the Payload newsroom.",
  "exports": {
    "./ui/*": "./src/ui/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles.css",
    "./postcss-scope": "./postcss/scope.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.60.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  }
}
