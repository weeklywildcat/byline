{
  "apiVersion": 3,
  "name": "byline/interactive",
  "version": "1.0.0",
  "title": "Interactive",
  "description": "A small self-contained interactive (a chart, calculator, quiz, map or data explorer) from one HTML file, isolated from the article in a sandboxed frame.",
  "category": "byline",
  "icon": "editor-code",
  "keywords": [
    "interactive",
    "quiz",
    "calculator",
    "data explorer",
    "html",
    "chart",
    "map",
    "graphic"
  ],
  "textdomain": "weekly-wildcat-headless",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "credit": {
      "type": "string",
      "default": ""
    },
    "document": {
      "type": "string",
      "default": ""
    },
    "fileName": {
      "type": "string",
      "default": ""
    },
    "heightPreset": {
      "type": "string",
      "default": "standard"
    },
    "align": {
      "type": "string",
      "default": "wide"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "customClassName": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./style-index.css",
  "postTypes": [
    "post"
  ]
}
