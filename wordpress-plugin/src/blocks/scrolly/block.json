{
  "apiVersion": 3,
  "name": "byline/scrolly",
  "version": "1.0.0",
  "title": "Scrollytelling",
  "description": "Photographs that stay in view while the reporting scrolls past. Build it step by step: a photograph and the words that go with it.",
  "category": "byline",
  "icon": "format-image",
  "keywords": [
    "feature",
    "immersive",
    "scroll",
    "scrollytelling",
    "photo essay",
    "sticky",
    "visual story"
  ],
  "textdomain": "weekly-wildcat-headless",
  "attributes": {
    "fit": {
      "type": "string",
      "default": "contain"
    },
    "align": {
      "type": "string",
      "default": "wide"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./style-index.css",
  "postTypes": [
    "post"
  ],
  "allowedBlocks": [
    "byline/scrolly-step"
  ]
}
