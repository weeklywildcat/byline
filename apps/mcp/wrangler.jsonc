{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "byline-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Configure your custom domain and bindings before deployment. No publication-specific defaults.
  "kv_namespaces": [{"binding":"OAUTH_KV","id":"REPLACE_WITH_OAUTH_KV_ID"}],
  "durable_objects": {"bindings":[{"name":"CONNECTIONS","class_name":"ConnectionVault"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["ConnectionVault"]}],
  "triggers": {"crons":["17 * * * *"]},
  "observability": {"enabled":true,"redact_query_string":true,"logs":{"enabled":true,"invocation_logs":false}},
  "vars": {"PUBLIC_URL":"https://mcp.example.invalid","WORDPRESS_URL":"https://wordpress.example.invalid","APPLICATION_ID":"cf2276ae-6bbb-4f7e-ae25-1b4929461791","ACTIVE_KEY_ID":"v1","ALLOWED_ORIGINS":""}
}
