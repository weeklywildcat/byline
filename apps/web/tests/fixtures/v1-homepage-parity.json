          }
        }
      },
      {
        "type": "latest-stories",
        "props": {
          "id": "v1-latest",
          "title": "Latest Stories",
          "query": {
            "type": "manual",
            "postIds": [4, 5]
          }
        }
      },
      {
        "type": "section-feed",
        "props": {
          "id": "v1-section-feed",
          "title": "Section Feed",
          "query": {
            "type": "manual",
            "postIds": [6, 7]
          }
        }
      },
      {
