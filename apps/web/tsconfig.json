{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@byline/core": ["../../packages/core/src/index.ts"],
      "@byline/content": ["../../packages/content/src/index.ts"],
      "@byline/content/story": ["../../packages/content/src/story/index.ts"],
      "@byline/design": ["../../packages/design/src/index.ts"],
      "@byline/theme-contract": ["../../packages/theme-contract/src/index.ts"],
      "@byline/theme-weekly-wildcat": ["../../packages/theme-weekly-wildcat/src/index.ts"],
      "@byline/theme-weekly-wildcat/publication": ["../../packages/theme-weekly-wildcat/src/publication.ts"],
      "@byline/story-presentations": ["../../packages/story-presentations/src/index.ts"],
      "@byline/ui": ["../../packages/ui/src/index.ts"],
      "@byline/ui/article-body": ["../../packages/ui/src/article-body/index.ts"],
      "@byline/ui/homepage": ["../../packages/ui/src/homepage/index.ts"],
      "@byline/article-body": ["../../packages/article-body/src/index.ts"],
      "@byline/article-body/fixtures": ["../../packages/article-body/src/fixtures.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
