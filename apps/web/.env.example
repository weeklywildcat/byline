# Export these as build environment variables. Never commit a real token.
BYLINE_NEWSROOM_BUILD_URL=https://newsroom.example.edu/api/byline/build
BYLINE_BUILD_TOKEN=
# Optional: require at least this public content revision.
# BYLINE_EXPECTED_REVISION=1
# For an offline fixture instead, leave the variables above unset and use:
# BYLINE_CONTENT_MODE=weekly-wildcat-fixture
