/**
 * Cloudflare `_redirects` support for the static export. Retired URLs (the old
 * sports archive routes) are real HTTP 301 rules in one file instead of
 * hundreds of generated HTML pages. Free of path aliases and non-erasable
 * TypeScript: Node runs it directly.
 * https://developers.cloudflare.com/workers/static-assets/redirects/
 */

export type EdgeRedirect = { from: string; to: string };

/** Cloudflare's limit for static (non-splat) rules in one `_redirects` file. */
export const MAX_STATIC_REDIRECTS = 2000;

const SOURCE = /^\/(?:[a-z0-9._~-]+\/)*$/i;
const DESTINATION = /^\/(?!\/)[a-z0-9._~/-]*(?:#[a-z0-9_-]+)?$/i;

/**
 * One rule per path, plus the same rule without the trailing slash: the asset
 * layer only redirects `/x` to `/x/` when a file exists there, and none does.
 */
export function buildRedirectsFile(redirects: EdgeRedirect[]) {
  const rules = new Map<string, string>();

  for (const { from, to } of redirects) {
    if (!SOURCE.test(from) || !DESTINATION.test(to)) throw new Error(`Unsafe redirect rule: ${from} -> ${to}`);
    for (const source of from === "/" ? [from] : [from, from.slice(0, -1)]) {
      if (rules.has(source) && rules.get(source) !== to) throw new Error(`Conflicting redirects for ${source}`);
      rules.set(source, to);
    }
  }

  if (rules.size > MAX_STATIC_REDIRECTS) {
    throw new Error(`${rules.size} redirect rules exceed Cloudflare's limit of ${MAX_STATIC_REDIRECTS} static redirects; use a splat or Bulk Redirects.`);
  }

  const lines = [...rules].sort(([left], [right]) => left.localeCompare(right)).map(([from, to]) => `${from} ${to} 301`);
  return `# Generated by scripts/generate-redirects.mjs from the route manifest. Do not edit.\n${lines.join("\n")}\n`;
}

/** Parse the rules this module writes (static, three fields) back into a map. */
export function parseRedirectsFile(source: string) {
  const rules = new Map<string, { to: string; status: number }>();

  for (const line of source.split("\n")) {
    const text = line.trim();
    if (!text || text.startsWith("#")) continue;
    const [from, to, status = "302"] = text.split(/\s+/);
    if (from && to && !rules.has(from)) rules.set(from, { to, status: Number(status) });
  }

  return rules;
}
