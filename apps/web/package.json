{
  "name": "@byline/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/astro-with-publication.mjs dev",
    "build": "node scripts/astro-with-publication.mjs build",
    "build:cloudflare": "node ../../scripts/build-cloudflare.mjs",
    "postbuild": "node scripts/report-build.mjs start && node scripts/materialize-static-compatibility.mjs && node scripts/generate-redirects.mjs && node scripts/generate-headers.mjs && node scripts/generate-byline-manifest.mjs && node scripts/verify-static-export.mjs && node scripts/verify-build.mjs && node scripts/verify-seo.mjs && node scripts/report-build.mjs end",
    "test": "vitest run",
    "materialize:publication-media": "node --import tsx scripts/materialize-publication-media.mts",
    "build:data-embed-fixture": "BYLINE_CONTENT_MODE=weekly-wildcat-fixture BYLINE_BUILD_SNAPSHOT_FILE=tests/fixtures/data-embed/snapshot.json BYLINE_BUILD_DATA_DIR=tests/fixtures/data/releases npm run build",
    "test:browser": "playwright test --config playwright.public.config.ts",
    "test:browser:data-embeds": "BYLINE_BROWSER_FIXTURE=data-embed playwright test --config playwright.public.config.ts",
    "test:packages": "vitest run tests/shared-contracts.test.ts tests/image-crops.test.ts tests/image-art-direction-intent.test.ts tests/publication-media-contract.test.ts tests/story-video.test.ts tests/article-body-renderer.test.tsx",
    "typecheck": "astro check && tsc --noEmit",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:preview": "wrangler preview --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@byline/content": "0.1.0",
    "@byline/core": "0.1.0",
    "@byline/data": "0.1.0",
    "@byline/data-presentations": "0.1.0",
    "@byline/design": "0.1.0",
    "@byline/story-presentations": "0.1.0",
    "@byline/theme-contract": "0.1.0",
    "@byline/theme-weekly-wildcat": "0.1.0",
    "@byline/ui": "0.1.0",
    "@iconify/react": "^6.0.2",
    "astro": "7.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@byline/site-contract": "0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/jsdom": "21.1.7",
    "tsx": "4.23.15",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "4.158.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "exports": {
    "./layout": "./src/layouts/BaseLayout.astro"
  }
}
