{
  "name": "@byline/web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/astro-with-publication.mjs dev",
    "build": "node scripts/astro-with-publication.mjs build",
    "postbuild": "node scripts/materialize-static-compatibility.mjs && node scripts/copy-wordpress-media-to-out.mjs && node scripts/materialize-presentation-media.mjs && node scripts/generate-redirects.mjs && node scripts/generate-byline-manifest.mjs && node scripts/verify-static-export.mjs && node scripts/verify-build.mjs && node scripts/verify-seo.mjs",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.public.config.ts",
    "test:packages": "vitest run tests/shared-contracts.test.ts",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@byline/content": "0.1.0",
    "@byline/core": "0.1.0",
    "@byline/design": "0.1.0",
    "@byline/theme-contract": "0.1.0",
    "@byline/theme-weekly-wildcat": "0.1.0",
    "@byline/ui": "0.1.0",
    "@iconify/react": "^6.0.2",
    "astro": "7.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "26.1.0",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
