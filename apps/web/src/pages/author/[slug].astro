---
import { routeCacheKey } from "@/lib/route-cache";
import { isGuestContributor } from "@/lib/wordpress";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import Page, { getMetadata } from "@/views/author/[slug]/page";
import { getBuildSnapshot } from "@/lib/build-snapshot";
export async function getStaticPaths() {
  const snapshot = await getBuildSnapshot();
  return snapshot.contributors.map((contributor) => ({ params: { slug: contributor.slug }, cacheKey: routeCacheKey(snapshot, "author", `${isGuestContributor(contributor) ? "guest" : "user"}:${contributor.id}`) }));
}
const params = { slug: Astro.params.slug! };
const metadata = await getMetadata({ params: Promise.resolve(params) });
---
<BaseLayout metadata={metadata}><Page params={Promise.resolve(params)} /></BaseLayout>
