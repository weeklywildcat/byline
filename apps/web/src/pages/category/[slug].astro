---
import { routeCacheKey } from "@/lib/route-cache";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import Page, { getMetadata } from "@/views/category/[slug]/page";
import { getBuildSnapshot } from "@/lib/build-snapshot";
import { isHiddenCategory } from "@/lib/content";
import { BEHIND_THE_SCENES } from "@/lib/behind-the-scenes";
import { THE_PROWLER } from "@/lib/the-prowler";
export async function getStaticPaths() {
  const snapshot = await getBuildSnapshot();
  return snapshot.categories.filter((category) => !isHiddenCategory(category)).map((category) => ({ params: { slug: category.slug }, cacheKey: routeCacheKey(snapshot, "category", category.id) }));
}
const params = { slug: Astro.params.slug! };
if (params.slug === BEHIND_THE_SCENES.slug) return Astro.redirect(BEHIND_THE_SCENES.path, 301);
if (params.slug === THE_PROWLER.slug) return Astro.redirect(THE_PROWLER.path, 301);
const metadata = await getMetadata({ params: Promise.resolve(params) });
---
<BaseLayout metadata={metadata}><Page params={Promise.resolve(params)} /></BaseLayout>
