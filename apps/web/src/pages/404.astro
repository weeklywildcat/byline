---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import Page from "@/views/not-found";
// The layout appends the publication name, so tabs and history read "Page not found | Weekly Wildcat".
const metadata = { title: "Page not found", robots: { index: false, follow: false } };
---
<BaseLayout metadata={metadata} noCanonical><Page /></BaseLayout>
