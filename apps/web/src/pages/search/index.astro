---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { getSearchPageProps, metadata } from "@/views/search/page";
import { SearchPageClient } from "@/components/SearchPageClient";
const { publicationName, searchGapEndpoint } = await getSearchPageProps();
---
<BaseLayout metadata={metadata}>
  <main class="search-page-shell"><SearchPageClient publicationName={publicationName} searchGapEndpoint={searchGapEndpoint} client:load /></main>
</BaseLayout>
