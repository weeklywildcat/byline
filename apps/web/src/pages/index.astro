---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import React from "react";
import { getHomepagePageData, metadata } from "@/views/page";
import { HomepageHeroRailLimiter } from "@/components/HomepageHeroRailLimiter";
import { BehindTheScenesSection } from "@/components/BehindTheScenesSection";
import { NewsletterSignupForm } from "@/components/NewsletterSignupForm";
import { HomepagePackages, ThisWeekCard, packageHeadingId } from "@byline/ui";
import { toCalendarEntries } from "@/lib/homepage-packages";
import { getPublicationConfig } from "@/lib/publication";
import { serializeJsonLd } from "@/lib/seo";
const data = await getHomepagePageData();
const publication = getPublicationConfig();
const leadPackages = data.resolvedHome.packages.filter((entry) => entry.type === "lead-package");
const newsletterPackages = data.resolvedHome.packages.filter((entry) => entry.type === "newsletter-package");
const relocateScript = `document.querySelectorAll('.astro-island-relocation[data-target]').forEach((source)=>{const target=document.getElementById(source.dataset.target);if(target)target.replaceChildren(...source.childNodes);source.remove()});`;
---
<BaseLayout metadata={metadata} stickyNav homepage>
  <script id="organization-json-ld" type="application/ld+json" set:html={serializeJsonLd(data.organizationSchema)}></script>
  <script id="website-json-ld" type="application/ld+json" set:html={serializeJsonLd(data.websiteSchema)}></script>
  <main class="byline-publication-preview live-home-shell" data-theme={publication.appearance.theme}>
      <HomepagePackages packages={data.resolvedHome.packages} theme={publication.appearance.theme} slots={{
        railLimiter: () => null,
        calendar: ({ package: resolvedPackage, packageId }) => "latest" in resolvedPackage ? React.createElement(ThisWeekCard, { entries: toCalendarEntries(data.sportsSchedule.schoolEvents, data.sportsSchedule.upcomingGames, resolvedPackage.utility.calendarLimit ?? 3), heading: resolvedPackage.utility.calendarHeading ?? "At NSHS", scheduleHref: "/sports/schedule/", headingId: packageHeadingId(`${packageId}-calendar`, "this-week-heading") }) : null,
        newsletter: ({ packageId }) => React.createElement("div", { id: `home-newsletter-${packageId}-slot` })
      }} />
      <BehindTheScenesSection posts={data.behindTheScenesPosts} />
  </main>
  {leadPackages.length > 0 && <HomepageHeroRailLimiter client:load />}
  {newsletterPackages.map((entry) => <div class="astro-island-relocation" data-target={`home-newsletter-${entry.package.packageId}-slot`}><NewsletterSignupForm headingId={packageHeadingId(`${entry.package.packageId}-heading`, "article-newsletter-heading")} heading={entry.package.heading} showLabel={entry.package.presentation.showLabel} client:visible /></div>)}
  <script is:inline set:html={relocateScript}></script>
</BaseLayout>
