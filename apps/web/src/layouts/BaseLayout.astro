---
import "@byline/theme-weekly-wildcat/styles.css";
import "@byline/ui/page-blocks.css";
import "@byline/ui/newsroom-blocks.css";
import "@byline/ui/article.css";
import "../../views/fonts.css";
import "../../views/globals.css";
import { SiteFooter } from "@/components/SiteFooter";
import { SiteHeader } from "@/components/SiteHeader";
import { absoluteUrl, getOrganizationSchema, serializeJsonLd, SITE_DESCRIPTION } from "@/lib/seo";
import { serializeMetadata, type Metadata } from "@/lib/metadata";
import { getPublicationConfig } from "@/lib/publication";
import { getActiveTheme, getThemeCssVariables, SELF_HOSTED_FONTS } from "@/lib/theme";

interface Props { metadata?: Metadata; themeColor?: string; noCanonical?: boolean; stickyLogo?: boolean; stickyNav?: boolean; }
const { metadata = {}, themeColor, noCanonical = false, stickyLogo = false, stickyNav = false } = Astro.props;
const publication = getPublicationConfig();
const activeTheme = getActiveTheme();
const rawTitle = typeof metadata.title === "string" ? metadata.title : publication.seo.defaultTitle;
const title = rawTitle === publication.seo.defaultTitle ? rawTitle : `${rawTitle} | ${publication.identity.shortName}`;
const description = typeof metadata.description === "string" ? metadata.description : SITE_DESCRIPTION;
const canonicalValue = metadata.alternates?.canonical;
const canonical = absoluteUrl(typeof canonicalValue === "string" ? canonicalValue : Astro.url.pathname);
const openGraph = metadata.openGraph ?? {};
const twitter = metadata.twitter ?? {};
const robots = metadata.robots ?? {};
const robotContent = robots.index === false ? `noindex,${robots.follow === false ? "nofollow" : "follow"}` : "index,follow";
const googleBot = robots.googleBot;
const googleContent = googleBot ? [
  googleBot.index === false ? "noindex" : "index",
  googleBot.follow === false ? "nofollow" : "follow",
  typeof googleBot["max-snippet"] === "number" ? `max-snippet:${googleBot["max-snippet"]}` : "",
  googleBot["max-image-preview"] ? `max-image-preview:${googleBot["max-image-preview"]}` : "",
  typeof googleBot["max-video-preview"] === "number" ? `max-video-preview:${googleBot["max-video-preview"]}` : ""
].filter(Boolean).join(",") : "";
const socialMetadataTags = serializeMetadata({
  openGraph: {
    title: openGraph.title ?? rawTitle,
    description: openGraph.description ?? description,
    ...(noCanonical ? {} : { url: openGraph.url ?? canonical }),
    siteName: openGraph.siteName ?? publication.identity.name,
    locale: openGraph.locale ?? publication.locale.replace(/-/g, "_"),
    type: openGraph.type ?? "website",
    images: openGraph.images,
    publishedTime: openGraph.publishedTime,
    modifiedTime: openGraph.modifiedTime,
    authors: openGraph.authors,
    section: openGraph.section,
    tags: openGraph.tags
  },
  twitter: {
    card: twitter.card ?? "summary_large_image",
    title: twitter.title ?? rawTitle,
    description: twitter.description ?? description,
    images: twitter.images
  }
});
const style = Object.entries(getThemeCssVariables(activeTheme.tokens)).map(([key, value]) => `${key}:${value}`).join(";");
---
<!doctype html>
<html lang={publication.locale} data-byline-theme={activeTheme.id} data-byline-density={activeTheme.tokens.density} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotContent} />
    {googleContent && <meta name="googlebot" content={googleContent} />}
    {!noCanonical && <link rel="canonical" href={canonical} />}
    {publication.branding.icons.map((icon) => <link rel={icon.width === 180 ? "apple-touch-icon" : "icon"} href={icon.url} sizes={icon.width && icon.height ? `${icon.width}x${icon.height}` : undefined} />)}
    {SELF_HOSTED_FONTS.preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />)}
    <link rel="stylesheet" href={SELF_HOSTED_FONTS.stylesheet} />
    {socialMetadataTags.map((tag) => tag.kind === "property"
      ? <meta property={tag.key} content={tag.content} />
      : <meta name={tag.key} content={tag.content} />)}
    <script id="organization-json-ld" type="application/ld+json" set:html={serializeJsonLd(getOrganizationSchema())}></script>
  </head>
  <body>
    <SiteHeader sticky={stickyLogo ? "logo" : stickyNav ? "nav" : undefined} />
    {stickyNav && <script is:inline>
      (function () {
        var nav = document.querySelector(".site-header--nav > .section-nav");
        if (!nav) return;
        // Mark the nav while it is pinned so its shadow only shows then.
        function update() { nav.classList.toggle("is-stuck", nav.getBoundingClientRect().top <= 0.5); }
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        update();
      })();
    </script>}
    {stickyLogo && <script is:inline>
      (function () {
        var bar = document.querySelector("[data-sticky-logo-bar]");
        var link = document.querySelector(".site-header--logo > .masthead-logo");
        var utility = document.querySelector(".site-header--logo > .site-utility");
        var logo = link && link.querySelector("img");
        if (!bar || !logo || !utility) return;

        // Pinning itself is native position: sticky (compositor-driven, so it
        // never lags or overshoots on momentum scrolling). This only sets the
        // size, tied to scroll: the logo shrinks into the bar as it pins.
        var BAR_HEIGHT = 46;   // docked bar height
        var LOGO_HEIGHT = 26;  // docked logo height
        var RAMP = 150;        // scroll distance over which the logo shrinks
        var STICK_TOP = 10;    // matches the logo's sticky top in CSS
        var start = 0;         // scroll position where the logo begins to pin
        var logoHeight = 0;
        var barHeight = 0;

        function measure() {
          var top = utility.getBoundingClientRect().bottom + window.scrollY;
          var margin = parseFloat(getComputedStyle(link).marginTop) || 0;
          logoHeight = logo.offsetHeight;
          barHeight = margin + logoHeight;
          start = top + margin - STICK_TOP;
          // The strip covers the logo's resting box and overlaps it, so nothing shifts.
          bar.style.height = barHeight + "px";
          bar.style.marginBottom = -barHeight + "px";
        }

        function update() {
          if (!logoHeight) return;
          var p = Math.max(0, Math.min(1, (window.scrollY - start) / RAMP));
          var e = p * p * (3 - 2 * p);
          logo.style.transform = "scale(" + (1 + e * (LOGO_HEIGHT / logoHeight - 1)) + ")";
          bar.style.transform = "scaleY(" + (1 + e * (BAR_HEIGHT / barHeight - 1)) + ")";
          bar.style.setProperty("--dock", e);
        }

        function refresh() { measure(); update(); }
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", refresh);
        window.addEventListener("load", refresh);
        refresh();
      })();
    </script>}
    <slot />
    <SiteFooter />
    {activeTheme.id === "weekly-wildcat" && <script is:inline>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","xi1qesbixb");
    </script>}
    <script is:inline>
      document.addEventListener("change", (event) => {
        const select = event.target;
        if (!(select instanceof HTMLSelectElement) || !select.closest(".team-hub-selector")) return;
        const href = select.selectedOptions[0]?.dataset.href;
        if (href) window.location.assign(href);
      });
    </script>
  </body>
</html>
