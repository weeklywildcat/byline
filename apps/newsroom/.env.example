# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://byline:byline@localhost:54329/byline_newsroom
# At least 32 random bytes: `openssl rand -base64 48`
PAYLOAD_SECRET=
# Public URL of this newsroom (used for admin links and Live Preview).
BYLINE_NEWSROOM_URL=http://localhost:3010
# Optional preferred sign-in. Use a Google OAuth Web application client.
# Register http://localhost and http://localhost:3010 as authorized JavaScript origins.
# Register http://localhost:3010/api/byline/auth/google/callback for local development.
# In production, register the HTTPS BYLINE_NEWSROOM_URL origin and callback there as well.
BYLINE_GOOGLE_CLIENT_ID=
BYLINE_GOOGLE_CLIENT_SECRET=
BYLINE_GOOGLE_HOSTED_DOMAIN=weeklywildcat.com
# Optional server-side key for rotating, attributed login photos.
BYLINE_UNSPLASH_ACCESS_KEY=
# 1 = Drizzle push in development. Production always runs committed migrations.
BYLINE_DB_PUSH=1

# Persistent directory for private Media originals and Payload's Library previews.
# Production should point this at a mounted persistent volume; relative paths are
# resolved from the newsroom app (apps/newsroom), never the process's working directory.
BYLINE_MEDIA_LOCAL_DIR=media

# Persistent directory for PREPARED publication files (content-addressed, public-safe
# web renditions, PDFs and audio made by the `media` jobs worker). A SEPARATE volume
# from BYLINE_MEDIA_LOCAL_DIR (Byline refuses to nest one inside the other). The web
# process and the `npm run jobs:media` worker must mount the same directory. Nothing
# here is ever deleted automatically: deployed snapshots may still reference it.
# See docs/publication-media.md.
BYLINE_PUBLICATION_MEDIA_DIR=publication-media

# Build-only credential for the static build's endpoints (GET /api/byline/build/media/:sha256,
# /snapshot, /snapshot/:sha256 and /direct), used by the static Astro build to acquire the
# public snapshot and prepared publication files (docs/payload-build-snapshots.md). At least 32 random characters:
# `openssl rand -base64 48`. Give the same value to the public build (and nothing
# else). Leave empty in development: the build endpoint is then disabled (404) and the
# newsroom works normally. It is never logged and never grants newsroom access.
BYLINE_BUILD_TOKEN=

# Optional private deploy-hook URL for the static public site (for example a
# Cloudflare Workers Builds production deploy hook). After a current public
# snapshot is promoted, the publication worker queues one coalescing deployment
# job and POSTs this HTTPS URL. The URL is credential-like: keep it only in the
# server environment, never in the Publication Global or repository.
BYLINE_DEPLOY_HOOK_URL=

# The `publication` Global (Payload admin → System) is the public publication configuration;
# BYLINE_PUBLICATION_JSON is no longer read by the newsroom. The static build side reads:
#   BYLINE_NEWSROOM_BUILD_URL=https://<newsroom>/api/byline/build
#   BYLINE_BUILD_TOKEN=<same value>
# Workers: npm run jobs:media (media), jobs:publication (public snapshots), jobs:scheduled (scheduled publish), jobs:maintenance (Content Health).

# Optional: YouTube Data API key for video-story metadata.
BYLINE_YOUTUBE_API_KEY=

# Optional email for notifications. Without it, notifications still appear in the Byline inbox.
# A nodemailer connection URL, e.g. smtps://user:app-password@smtp.gmail.com:465
BYLINE_SMTP_URL=
BYLINE_EMAIL_FROM="The Weekly Wildcat <newsroom@weeklywildcat.com>"

# Private reporting files (interview recordings, documents): their own directory, never Media's,
# never published. Relative paths resolve from apps/newsroom. See docs/reporting.md.
BYLINE_REPORTING_LOCAL_DIR=reporting-files

# Transcripts are reporter-provided (.txt, .srt or .vtt). Byline does not run an
# automatic speech-to-text service or send interview audio to a transcription provider.
