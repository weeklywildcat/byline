# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://byline:byline@localhost:54329/byline_newsroom
# At least 32 random bytes: `openssl rand -base64 48`
PAYLOAD_SECRET=
# Public URL of this newsroom (used for admin links and Live Preview).
BYLINE_NEWSROOM_URL=http://localhost:3010
# Optional preferred sign-in. Use a Google OAuth Web application client.
# Register http://localhost:3010/api/byline/auth/google/callback for local development.
# In production, register the same path on the HTTPS BYLINE_NEWSROOM_URL origin.
BYLINE_GOOGLE_CLIENT_ID=
BYLINE_GOOGLE_CLIENT_SECRET=
BYLINE_GOOGLE_HOSTED_DOMAIN=weeklywildcat.com
# Optional server-side key for rotating, attributed login photos.
BYLINE_UNSPLASH_ACCESS_KEY=
# 1 = Drizzle push in development. Production always runs committed migrations.
BYLINE_DB_PUSH=1

# Persistent directory for private Media originals and Payload's Library previews.
# Production should point this at a mounted persistent volume; relative paths are
# resolved from the newsroom app.
BYLINE_MEDIA_LOCAL_DIR=media

# Optional: YouTube Data API key for video-story metadata.
BYLINE_YOUTUBE_API_KEY=
