{
  "name": "@byline/newsroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "jobs": "payload jobs:run --cron '* * * * *' --all-queues --handle-schedules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate:check": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@byline/core": "0.1.0",
    "@byline/newsroom-screens": "0.1.0",
    "@byline/newsroom-ui": "0.1.0",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@tanstack/react-query": "5.104.5",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "payload": "3.92.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "pg": "8.20.0",
    "postcss": "8.5.31",
    "postcss-nesting": "14.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
