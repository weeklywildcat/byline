{
  "name": "byline-monorepo",
  "version": "0.2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "wordpress-plugin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @byline/web",
    "env:start": "npm run env:start --workspace @byline/wordpress-plugin",
    "env:stop": "npm run env:stop --workspace @byline/wordpress-plugin",
    "typecheck": "npm run typecheck:packages && npm run typecheck:frontend && npm run typecheck:plugin && npm run typecheck:discord && npm run typecheck:mcp",
    "typecheck:packages": "tsc --noEmit -p tsconfig.packages.json",
    "typecheck:frontend": "npm run typecheck --workspace @byline/web",
    "typecheck:plugin": "npm run typecheck --workspace @byline/wordpress-plugin",
    "typecheck:discord": "npm run typecheck --workspace @byline/discord-bot",
    "test": "npm run test:packages && npm run test:frontend && npm run test:plugin && npm run test:php && npm run test:discord && npm run test:mcp",
    "test:packages": "npm run test:packages --workspace @byline/web && npm run test:admin-runtime",
    "test:admin-runtime": "npm run test --workspace @byline/admin-runtime",
    "test:frontend": "npm run test --workspace @byline/web",
    "test:frontend:browser": "npm run test:browser --workspace @byline/web",
    "test:plugin": "npm run test --workspace @byline/wordpress-plugin",
    "test:php": "bash scripts/test-plugin-php.sh",
    "test:discord": "npm run test --workspace @byline/discord-bot",
    "test:e2e": "npm run test:e2e:wp71",
    "test:e2e:wp71": "npm run test:e2e:primary --workspace @byline/wordpress-plugin",
    "build": "npm run build:frontend && npm run build:plugin && npm run build:discord",
    "build:frontend": "npm run build --workspace @byline/web",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:plugin": "npm run build --workspace @byline/wordpress-plugin",
    "build:discord": "npm run build --workspace @byline/discord-bot",
    "package:plugin": "bash scripts/package-plugin.sh",
    "story-presentation": "node scripts/story-presentation.mjs",
    "verify:contracts": "node scripts/verify-monorepo-contracts.mjs && node scripts/verify-updater-transition.mjs && node scripts/verify-shared-style-contracts.mjs && node scripts/verify-editor-canvas-contract.mjs && node --test scripts/prepare-release.test.mjs scripts/story-presentation.test.mjs && npm run verify:mcp-catalog",
    "test:frontend:snapshot-build": "npm run test:snapshot-build --workspace @byline/web",
    "typecheck:mcp": "npm run typecheck --workspace @byline/mcp-contracts",
    "test:mcp": "npm run test --workspace @byline/mcp-contracts",
    "build:mcp": "bash scripts/build-plugin-mcp.sh",
    "mcp:catalog": "npm run catalog --workspace @byline/mcp-contracts",
    "test:mcp:wordpress": "bash scripts/test-mcp-wordpress.sh",
    "verify:mcp-catalog": "npm run verify --workspace @byline/mcp-contracts"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "cookie": "^2.0.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/binding-linux-x64-musl": "1.2.5"
  },
  "engines": {
    "node": ">=24"
  }
}
